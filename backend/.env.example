# Copy to .env only for a manually configured PostgreSQL instance.
# The dev_db.py helper generates a random password and .env automatically.
POSTGRES_USER=agnicalendar
POSTGRES_PASSWORD=replace-with-your-password
POSTGRES_DB=agnicalendar
DATABASE_URL=postgresql://agnicalendar:replace-with-your-password@127.0.0.1:55432/agnicalendar
# Signs access tokens. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_JWT_SECRET=replace-with-a-long-random-secret
# Free NASA FIRMS key (https://firms.modaps.eosdis.nasa.gov/api/map_key/) for 7/30-day map windows
FIRMS_MAP_KEY=
